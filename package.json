{
  "name": "@fingerly/react-native",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "React Native SDK — a bridge to the native iOS and Android SDKs, which do the collecting",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/fingerly-io/sdk-react-native.git"},
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "ios", "android", "fingerly-react-native.podspec"],
  "sideEffects": false,
  "dependencies": {
    "@fingerly/types": "workspace:*"
  },
  "peerDependencies": {
    "react-native": ">=0.73"
  },
  "scripts": {
    "build:types": "pnpm --filter @fingerly/types build",
    "build": "pnpm build:types && tsup",
    "lint": "pnpm build:types && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
